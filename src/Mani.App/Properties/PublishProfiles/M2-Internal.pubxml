<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Explicit internal validation opt-in. Ordinary Release/publish stays clean. -->
    <EnableDiagnostics>true</EnableDiagnostics>
    <DefineConstants Condition="'$(EnableDiagnostics)' == 'true'">$(DefineConstants);MANI_DIAGNOSTICS</DefineConstants>
    <!-- Internal validation includes reflection-based diagnostic serialization. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
