              <NumberBox x:Name="QuickSecondaryDelay" x:Uid="QuickSecondaryDelay" AutomationProperties.AutomationId="QuickSecondaryDelay" Tag="secondary-sub-delay" SmallChange="0.1" SpinButtonPlacementMode="Inline" ValueChanged="QuickNumber_Changed" />
