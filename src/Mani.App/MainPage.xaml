<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Mani_App.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Mani_App"
      Loaded="Page_Loaded" RequestedTheme="Dark" Language="en-US" KeyboardAcceleratorPlacementMode="Hidden" PreviewKeyDown="Page_PreviewKeyDown">
  <Page.Resources>
    <local:DelaySecondsConverter x:Key="DelaySeconds" />
    <DataTemplate x:Key="QuickTrackTemplate">
      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label}" />
    </DataTemplate>
  </Page.Resources>
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewWindowShortcut_Invoked" />
    <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseWindowShortcut_Invoked" />
    <KeyboardAccelerator Key="M" Modifiers="Control,Shift" Invoked="MusicShortcut_Invoked" />
    <KeyboardAccelerator Key="Space" Invoked="PlayShortcut_Invoked" />
    <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenShortcut_Invoked" />
    <KeyboardAccelerator Key="O" Modifiers="Control,Shift" Invoked="OpenUrlShortcut_Invoked" />
    <KeyboardAccelerator Key="F11" Invoked="FullscreenShortcut_Invoked" />
  </Page.KeyboardAccelerators>
  <Grid Background="Black">
    <Grid x:Name="VideoArea" Background="Black" AllowDrop="True" DragOver="Video_DragOver" Drop="Video_Drop" SizeChanged="Video_SizeChanged">
      <Grid x:Name="VideoViewport">
      <SwapChainPanel x:Name="VideoPanel" IsHitTestVisible="False" SizeChanged="Video_SizeChanged" CompositionScaleChanged="Video_ScaleChanged" />
      <Image x:Name="DefaultMusicArtwork" Source="Assets/default-album-art.png" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
      <local:VideoSurfaceButton x:Name="VideoFocus" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Background="Transparent" BorderThickness="0" Padding="0" TabIndex="0" KeyboardAcceleratorPlacementMode="Hidden"
              x:Uid="VideoFocus" AutomationProperties.AutomationId="VideoFocus" Click="VideoFocus_Click"
              RightTapped="Video_RightTapped" ContextRequested="Video_ContextRequested">
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="F10" Modifiers="Shift" Invoked="Video_MenuShortcut" />
          <KeyboardAccelerator Key="Application" Invoked="Video_MenuShortcut" />
        </Button.KeyboardAccelerators>
        <Button.Template><ControlTemplate TargetType="Button"><Grid Background="Transparent" /></ControlTemplate></Button.Template>
      </local:VideoSurfaceButton>
      <Border x:Name="EmptyBackdrop" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="24" MaxWidth="420">
            <Image Source="Assets/Square150x150Logo.png" Width="88" Height="88" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="Mani" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyHeading" x:Uid="Welcome" FontSize="20" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="EmptyMessage" x:Uid="DropHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            <ProgressRing x:Name="LoadingRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
              <Button x:Name="OpenButton" x:Uid="OpenFile" IsEnabled="False" Click="Open_Click" AutomationProperties.AutomationId="OpenFile" />
              <Button x:Name="OpenUrlButton" x:Uid="OpenUrl" IsEnabled="False" Click="OpenUrl_Click" AutomationProperties.AutomationId="OpenUrl" />
            </StackPanel>
            <Button x:Name="CancelOpenButton" x:Uid="CancelOpen" HorizontalAlignment="Center" Visibility="Collapsed" Click="Stop_Click" />
            <Button x:Name="WelcomeMore" x:Uid="More" HorizontalAlignment="Center" Click="WelcomeMore_Click" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <TextBlock x:Name="MediaTitle" Visibility="Collapsed" />
      <Border x:Name="InfoPanel" Width="280" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="12,60,16,200"
              Background="#E0202028" CornerRadius="12" Padding="16" Visibility="Collapsed">
        <ScrollViewer><StackPanel Spacing="12">
          <TextBlock x:Name="InfoHeading" FontSize="20" />
          <TextBlock x:Name="Diagnostics" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
          <Button x:Name="OpenLogsButton" Click="Logs_Click" />
        </StackPanel></ScrollViewer>
      </Border>
      <Border x:Name="WebProbePanel" Width="320" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="12" Background="#20202B" BorderBrush="#606070" BorderThickness="1" Visibility="Collapsed">
        <Grid x:Name="WebProbeContainer" />
      </Border>
      <Border x:Name="WindowCheckBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="12" Padding="12" Background="#E0202028" CornerRadius="8">
        <StackPanel Spacing="6">
          <TextBlock x:Name="WindowCheckProgress" Text="Window checks" TextWrapping="Wrap" MaxWidth="560" />
          <TextBlock Text="Watch and listen. Do not move or resize the window." />
          <Button x:Name="SleepContinueButton" Content="Continue after wake" Visibility="Collapsed" IsEnabled="False" Click="SleepContinue_Click" />
          <Button Content="Cancel window check" Click="CancelProbe_Click" />
        </StackPanel>
      </Border>
      <Border x:Name="SubtitleCheckBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="12" Padding="12" MaxWidth="760" Background="#F0202028" CornerRadius="8">
        <StackPanel Spacing="6">
          <TextBlock x:Name="SubtitleCheckProgress" Text="Subtitle checks" FontSize="18" />
          <TextBlock x:Name="SubtitleCheckHint" Text="Watch the two subtitle tracks." TextWrapping="Wrap" />
          <Button Content="Cancel subtitle check" Click="CancelProbe_Click" />
        </StackPanel>
      </Border>
      <Border x:Name="LabPanel" Width="360" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="12,12,12,190"
              Background="#F0202028" CornerRadius="12" Padding="14" Visibility="Collapsed">
        <ScrollViewer><StackPanel Spacing="10">
          <TextBlock Text="M1 diagnostics" FontSize="20" />
          <TextBlock Text="Technical probes. Results are saved in the log folder." TextWrapping="Wrap" />
          <Button Content="Run M1 window and 4K checks" Click="WindowAnd4kChecks_Click" />
          <TextBlock Text="Use this after HDR timing has already been collected. Open your 4K SDR video with audio first. Keep Windows HDR on. Runs the window and overlay checks, then pauses; about two minutes plus file verification." TextWrapping="Wrap" />
          <Button Content="Run M1 combined checks" Click="CombinedChecks_Click" />
          <TextBlock Text="Keep Windows HDR on. Runs HDR GPU timing, then WebView2 and blur through window sizes and fullscreen. About three minutes, then pauses. Optionally open a real 4K SDR video with audio first to include it (about one extra minute). No multi-monitor or sleep checks." TextWrapping="Wrap" />
          <Button Content="Measure HDR GPU blur" Click="HdrGpuTiming_Click" />
          <TextBlock Text="Keep Windows HDR on. Automatically opens the HDR sample and compares blur off/on/on/off, then pauses. About two minutes. Keep the window and display unchanged; pauses between stages are expected." TextWrapping="Wrap" />
          <Button Content="Measure current video GPU blur" Click="GpuTiming_Click" />
          <TextBlock Text="Open an SDR video with audio first. Compares blur off/on/on/off using the same scene, then pauses. About two minutes plus file verification. Keep the window and display unchanged; pauses between stages are expected." TextWrapping="Wrap" />
          <Button Content="Run HDR overlay checks" Click="HdrOverlay_Click" />
          <TextBlock Text="Keep Windows HDR on. Automatically checks HDR, HDR-to-SDR and restored HDR with five overlay states each, then pauses. Watch the picture and blur; listen during playback. About one to two minutes." TextWrapping="Wrap" />
          <Button Content="Run current video overlay checks" Click="CurrentVideoOverlay_Click" />
          <TextBlock Text="Open an SDR video with audio and choose a scene first. Checks five overlay states using about 10 seconds from that position each time, then pauses. Watch and listen; pauses between stages are expected. About one minute plus file verification." TextWrapping="Wrap" />
          <Button Content="Run 1080p / 4K overlay matrix" Click="OverlayMatrix_Click" />
          <TextBlock Text="Automatically checks both silent SDR samples with WebView2, GPU blur and both together. Watch the picture and control background; do not operate the player. About one minute." TextWrapping="Wrap" />
          <Button Content="Run automated host checks" Click="AutomatedHostChecks_Click" />
          <TextBlock Text="Checks WebView2, capture and 50 panel rebuilds. Playback is restored afterward. Visual and hardware checks remain separate." TextWrapping="Wrap" />
          <Button Content="Refresh display / HDR details" Click="DisplayProbe_Click" />
          <Button Content="Run window / fullscreen checks" Click="WindowChecks_Click" />
          <Button Content="Run minimize / restore checks" Click="MinimizeChecks_Click" />
          <TextBlock Text="Automatically minimizes and restores twice: once playing, once paused. Audio should continue during the first minimize and stop during the paused stages. Takes about one minute." TextWrapping="Wrap" />
          <Button Content="Run lock / unlock checks" Click="SessionLockChecks_Click" />
          <TextBlock Text="Follow the banner: lock Windows with Win+L twice, wait 10 seconds each time, then unlock. First playing, then paused. Keep the computer awake. Takes about two minutes." TextWrapping="Wrap" />
          <Button Content="Run sleep / wake checks" Click="SleepChecks_Click" />
          <TextBlock Text="Follow the banner: choose Windows Start > Power > Sleep, wait 10 seconds, then wake and unlock. Click Continue after wake. Playback pauses for sleep; the check then tests playback recovery." TextWrapping="Wrap" />
          <Button Content="Run DPI / scale checks" Click="DpiChecks_Click" />
          <TextBlock Text="Follow the banner: set Windows display Scale to 100%, 150%, 200%, then restore the original value. Keep resolution and HDR unchanged. Takes about two minutes." TextWrapping="Wrap" />
          <TextBlock x:Name="WindowCheckStatus" Text="Automatically resizes the window and enters/exits fullscreen, then restores it. Keep Windows HDR and scale unchanged; watch and listen. Takes about 20 seconds." TextWrapping="Wrap" />
          <Button Content="Run SDR / HDR checks" Click="DisplayChecks_Click" />
          <TextBlock Text="Opens four short test cases and saves display evidence. Target settings are restored; the test video stays paused." TextWrapping="Wrap" />
          <Button Content="Run HDR switch checks" Click="HdrSwitchChecks_Click" />
          <Button Content="Run playing HDR switch checks" Tag="playing" Click="HdrSwitchChecks_Click" />
          <TextBlock Text="Plays moving HDR bars with a quiet steady tone. Follow the HDR off/on prompts below and watch/listen for interruptions. Stops paused when done." TextWrapping="Wrap" />
          <TextBlock x:Name="HdrSwitchStatus" Text="Start with Windows HDR on. This check will ask you to turn it off, then on. Keep the window on one display. The sample stays paused." TextWrapping="Wrap" />
          <Button Content="Cancel HDR switch check" Click="CancelProbe_Click" />
          <Button Content="Run dual-subtitle visual checks" Click="SubtitleChecks_Click" />
          <TextBlock x:Name="SubtitleCheckStatus" Text="Automatically opens a sample and checks two ASS tracks. Watch the text, movement and positions for about one minute. The sample stays paused when done." TextWrapping="Wrap" />
          <Button Content="Load primary subtitle" Tag="primary" Click="SubtitleProbe_Click" />
          <NumberBox x:Name="PrimaryDelay" Header="Primary delay (seconds)" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Inline" Tag="sub-delay" ValueChanged="SubtitleNumber_Changed" />
          <NumberBox x:Name="PrimaryPosition" Header="Primary position (%)" Value="100" Minimum="0" Maximum="150" Tag="sub-pos" ValueChanged="SubtitleNumber_Changed" />
          <ComboBox x:Name="PrimaryStyle" Header="Primary ASS mode" SelectedIndex="2" Tag="sub-ass-override" SelectionChanged="SubtitleStyle_Changed">
            <ComboBoxItem Content="Preserve ASS" Tag="no"/><ComboBoxItem Content="Default override" Tag="yes"/><ComboBoxItem Content="Scale override" Tag="scale"/><ComboBoxItem Content="Force styles" Tag="force"/><ComboBoxItem Content="Plain text" Tag="strip"/>
          </ComboBox>
          <Button Content="Load secondary subtitle" Tag="secondary" Click="SubtitleProbe_Click" />
          <NumberBox x:Name="SecondaryDelay" Header="Secondary delay (seconds)" Value="0" SmallChange="0.1" SpinButtonPlacementMode="Inline" Tag="secondary-sub-delay" ValueChanged="SubtitleNumber_Changed" />
          <NumberBox x:Name="SecondaryPosition" Header="Secondary position (%)" Value="0" Minimum="0" Maximum="150" Tag="secondary-sub-pos" ValueChanged="SubtitleNumber_Changed" />
          <ComboBox x:Name="SecondaryStyle" Header="Secondary ASS mode" SelectedIndex="4" Tag="secondary-sub-ass-override" SelectionChanged="SubtitleStyle_Changed">
            <ComboBoxItem Content="Preserve ASS" Tag="no"/><ComboBoxItem Content="Default override" Tag="yes"/><ComboBoxItem Content="Scale override" Tag="scale"/><ComboBoxItem Content="Force styles" Tag="force"/><ComboBoxItem Content="Plain text" Tag="strip"/>
          </ComboBox>
          <Button Content="Clear A-B loop" Click="ClearLoop_Click" />
          <Button Content="Toggle GPU blur experiment" Click="BlurProbe_Click" />
          <TextBlock Text="Rounded GPU blur experiment. HDR, resizing and animation require visual acceptance." TextWrapping="Wrap" />
          <Button Content="Toggle WebView2 overlay" Click="WebProbe_Click" />
          <Button Content="Check WebView2 only" Click="WebHostChecks_Click" />
          <Button Content="Prepare interaction checks" Click="PrepareInteraction_Click" />
          <TextBlock Text="Opens the test video and enables WebView2 and GPU blur. Keeps your volume and display settings." TextWrapping="Wrap" />
          <TextBlock x:Name="InteractionStatus" Text="Prepare first, then type in the web input and save a snapshot." TextWrapping="Wrap" />
          <Button Content="Save interaction snapshot" Click="InteractionSnapshot_Click" />
          <TextBlock Text="Save after typing in WebView2, with blur enabled, and after closing both overlays. Captures counters and rendering state; does not record typed text." TextWrapping="Wrap" />
          <Expander Header="Deferred: OCR (M6)" IsExpanded="False">
            <StackPanel Spacing="8">
          <ComboBox x:Name="OcrLanguage" Header="OCR language" SelectedIndex="0">
            <ComboBoxItem Content="English (United States)" Tag="en-US"/><ComboBoxItem Content="Chinese (Simplified)" Tag="zh-Hans-CN"/>
          </ComboBox>
          <Button Content="Capture independent frame + OCR" Click="OcrProbe_Click" />
            </StackPanel>
          </Expander>
          <Button Content="Measure fresh playback baseline" Click="PlaybackBaseline_Click" />
          <Button Content="Open and measure 1080p test video" Tag="1080p" Click="ResolutionBaseline_Click" />
          <Button Content="Open and measure 4K test video" Tag="4k" Click="ResolutionBaseline_Click" />
          <TextBlock Text="Start a fresh Mani session and run python scripts/run_m1_baselines.py --collect-host. Measure your video, then 1080p and 4K. Close Mani after all three finish. No panel rebuilds." TextWrapping="Wrap" />
          <Button Content="Measure 30-minute playback" Click="LongPlayback_Click" />
          <TextBlock Text="Use a fresh session and a real movie with over 30 minutes remaining. Start python scripts/run_m1_long_playback.py first. Keep the window and display unchanged." TextWrapping="Wrap" />
          <Button Content="Run stability + performance" Click="StabilityAndPerformance_Click" />
          <TextBlock Text="Two rounds of 50 rebuilds, idle recovery samples, then playback metrics. Use a 15-second or longer video. Turn off blur and WebView2 first. Allow several minutes." TextWrapping="Wrap" />
          <Button Content="Measure seek / playback performance" Click="BenchmarkProbe_Click" />
          <Button Content="Run 50 video-host cycles" Click="HostStress_Click" />
          <Button Content="Cancel running probe" Click="CancelProbe_Click" />
          <TextBox x:Name="LabResults" Header="Probe result" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
          <Button Content="Open log folder" Click="Logs_Click" />
          <Button Content="Close diagnostics" Click="Lab_Click" />
        </StackPanel></ScrollViewer>
      </Border>
      <Border x:Name="OsdOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="16,8" CornerRadius="10"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" Visibility="Collapsed"
              AutomationProperties.AutomationId="OsdOverlay">
        <StackPanel Spacing="4" FlowDirection="LeftToRight">
          <TextBlock x:Name="OsdTitle" FontSize="20" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="OsdTitle" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="OsdDetail" FontSize="11" TextTrimming="CharacterEllipsis" Visibility="Collapsed" AutomationProperties.AutomationId="OsdDetail" />
          <ProgressBar x:Name="OsdProgress" Minimum="0" Maximum="1" Height="12" Visibility="Collapsed" AutomationProperties.AutomationId="OsdProgress" />
        </StackPanel>
      </Border>
      <Border x:Name="StatusOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="10,6" CornerRadius="6"
              Background="#D0202028" IsHitTestVisible="False" Visibility="Collapsed" MaxWidth="520">
        <TextBlock x:Name="Status" x:Uid="Initializing" TextWrapping="Wrap" />
      </Border>
      </Grid>
      <Border x:Name="Controls" VerticalAlignment="Top" HorizontalAlignment="Left" Width="460"
              Visibility="Collapsed" IsHitTestVisible="False" Opacity="0"
              Background="#AA25252E" BorderBrush="#60606068" BorderThickness="1" CornerRadius="12" Padding="8,0,8,8"
              SizeChanged="Controls_SizeChanged" PointerEntered="Controls_PointerEntered" PointerExited="Controls_PointerExited">
        <Border.RenderTransform><TranslateTransform x:Name="OscTranslation" /></Border.RenderTransform>
        <UserControl x:Name="ControlsHost"><UserControl.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries><ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFE5E5E8" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFCCCCD2" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFB8B8C0" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFDADAE0" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFB8B8C0" />
    </ResourceDictionary><ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorWindowTextColor}"/><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemColorHighlightColor}"/></ResourceDictionary></ResourceDictionary.ThemeDictionaries>
    <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double></ResourceDictionary></UserControl.Resources>
        <Grid x:Name="OscFragments" ColumnSpacing="4">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="32"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
          <Grid x:Name="OscDragHandle" Grid.ColumnSpan="4" Height="14" Background="Transparent"
                PointerPressed="OscDrag_Pressed" PointerMoved="OscDrag_Moved" PointerReleased="OscDrag_Released" PointerCaptureLost="OscDrag_Released"
                x:Uid="DragControls">
              <!-- IINA uses the empty top padding as its drag region. Keep the tested hit target without a separate grip mark. -->
          </Grid>
            <StackPanel x:Name="OscVolume" Grid.Row="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Style="{StaticResource GlassIconButton}" x:Name="MainMuteButton" AutomationProperties.AutomationId="MuteButton" x:Uid="Mute" Width="32" Height="32" Padding="0" Click="Mute_Click"><FontIcon x:Name="MainMuteIcon" Glyph="&#xE767;" FontSize="16" /></Button>
              <local:WheelSlider Style="{StaticResource DefaultSliderStyle}" x:Name="MainVolume" Width="70" Minimum="0" Maximum="100" Value="50" IsEnabled="False" ValueChanged="Volume_Changed" x:Uid="Volume" AutomationProperties.AutomationId="Volume" />
            </StackPanel>
            <StackPanel x:Name="OscPlayback" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Style="{StaticResource GlassIconButton}" x:Name="MainSeekBackButton" AutomationProperties.AutomationId="SeekBackButton" x:Uid="SeekBack" Width="32" Height="32" Padding="0" Tag="-5" Click="RelativeSeek_Click"><FontIcon Glyph="&#xE892;" FontSize="16" /></Button>
              <Button Style="{StaticResource GlassIconButton}" x:Name="MainPlayButton" x:Uid="PlayButton" Width="32" Height="32" Padding="0" IsEnabled="False" Click="Play_Click" AutomationProperties.AutomationId="PlayButton"><FontIcon x:Name="MainPlayIcon" Glyph="&#xE768;" FontSize="20" /></Button>
              <Button Style="{StaticResource GlassIconButton}" x:Name="MainSeekForwardButton" AutomationProperties.AutomationId="SeekForwardButton" x:Uid="SeekForward" Width="32" Height="32" Padding="0" Tag="5" Click="RelativeSeek_Click"><FontIcon Glyph="&#xE893;" FontSize="16" /></Button>
            </StackPanel>
            <StackPanel x:Name="OscToolbar" Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
              <Button Style="{StaticResource GlassIconButton}" x:Name="PipReturnButton" x:Uid="PipReturnButton" Width="32" Height="32" Padding="0" Visibility="Collapsed" Click="PictureInPicture_Click" AutomationProperties.AutomationId="PipReturnButton"><FontIcon Glyph="&#xE8A7;" FontSize="16" /></Button>
              <Button Style="{StaticResource GlassIconButton}" x:Name="FullscreenButton" x:Uid="FullscreenButton" MinWidth="28" Width="28" Height="32" Padding="0" Click="Fullscreen_Click"><FontIcon Glyph="&#xE740;" FontSize="16" /></Button>
              <Button x:Name="PipToolbarButton" Style="{StaticResource GlassIconButton}" x:Uid="PipToolbarButton" Width="28" Height="32" MinWidth="28" Click="PictureInPicture_Click" AutomationProperties.AutomationId="PipToolbarButton"><FontIcon Glyph="&#xE8A7;" FontSize="15" /></Button>
              <Button x:Name="SettingsToolbarButton" Style="{StaticResource GlassIconButton}" x:Uid="SettingsToolbarButton" Width="28" Height="32" MinWidth="28" Click="QuickToolbar_Click" AutomationProperties.AutomationId="SettingsToolbarButton"><FontIcon Glyph="&#xE713;" FontSize="15" /></Button>
              <Button Style="{StaticResource GlassIconButton}" x:Name="MoreButton" x:Uid="MoreButton" MinWidth="28" Width="28" Height="32" Padding="0"><FontIcon Glyph="&#xE712;" FontSize="16" />
              <Button.Flyout><MenuFlyout x:Name="MainMenu" Opened="OscMenu_Opened" Closed="OscMenu_Closed">
  <MenuFlyoutSubItem x:Name="FileMenu" x:Uid="FileMenu" AutomationProperties.AutomationId="FileMenu">
    <MenuFlyoutItem x:Name="OpenFileMenu" x:Uid="OpenFileMenu" Click="Open_Click"/>
    <MenuFlyoutItem x:Name="OpenUrlMenu" x:Uid="OpenUrlMenu" Click="OpenUrl_Click"/>
    <MenuFlyoutItem x:Name="RevealFileMenu" x:Uid="RevealFileMenu" KeyboardAcceleratorTextOverride="Ctrl+Shift+R" Click="RevealFile_Click"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="NewWindowMenu" x:Uid="NewWindowMenu" Click="NewWindow_Click" AutomationProperties.AutomationId="NewWindowMenu" KeyboardAcceleratorTextOverride="Ctrl+N"/>
    <MenuFlyoutItem x:Name="LocalizedControl1" x:Uid="CloseWindowMenu" Click="CloseWindow_Click" AutomationProperties.AutomationId="CloseWindowMenu" KeyboardAcceleratorTextOverride="Ctrl+W"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="LocalizedControl2" x:Uid="ExitMenu" Click="Exit_Click" AutomationProperties.AutomationId="ExitMenu" KeyboardAcceleratorTextOverride="Q"/>
  </MenuFlyoutSubItem>
  <MenuFlyoutSubItem x:Name="PlaybackMenu" x:Uid="PlaybackMenu" AutomationProperties.AutomationId="PlaybackMenu">
    <MenuFlyoutItem x:Name="PlayPauseMenu" KeyboardAcceleratorTextOverride="Space" Click="MenuPlay_Click"/>
    <MenuFlyoutItem x:Name="StopMenu" x:Uid="StopMenu" Click="Stop_Click" KeyboardAcceleratorTextOverride="Ctrl+."/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="SeekBackMenu" KeyboardAcceleratorTextOverride="Left" x:Uid="SeekBackMenu" Tag="-5" Click="RelativeSeek_Click"/>
    <MenuFlyoutItem x:Name="SeekForwardMenu" KeyboardAcceleratorTextOverride="Right" x:Uid="SeekForwardMenu" Tag="5" Click="RelativeSeek_Click"/>
    <MenuFlyoutItem x:Name="FrameBackMenu" KeyboardAcceleratorTextOverride="Alt+Left" x:Uid="PreviousFrameMenu" Click="FrameBack_Click"/>
    <MenuFlyoutItem x:Name="FrameForwardMenu" KeyboardAcceleratorTextOverride="Alt+Right" x:Uid="NextFrameMenu" Click="FrameForward_Click"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutSubItem x:Name="SpeedMenu" x:Uid="SpeedMenu">
      <MenuFlyoutItem x:Name="LocalizedControl3" x:Uid="HalfSpeed" Tag="0.5" Click="Speed_Click"/>
      <MenuFlyoutItem x:Name="LocalizedControl4" x:Uid="NormalSpeed" Tag="1" Click="Speed_Click"/>
      <MenuFlyoutItem x:Name="LocalizedControl5" x:Uid="DoubleSpeed" Tag="2" Click="Speed_Click"/>
    </MenuFlyoutSubItem>
    <MenuFlyoutSubItem x:Name="LoopMenu" x:Uid="LoopMenu" AutomationProperties.AutomationId="LoopMenu">
      <ToggleMenuFlyoutItem x:Name="FileLoopMenu" KeyboardAcceleratorTextOverride="Ctrl+Shift+L" x:Uid="LoopFileMenu" Click="FileLoop_Click"/>
      <MenuFlyoutItem x:Name="AbLoopMenu" KeyboardAcceleratorTextOverride="Ctrl+L" x:Uid="AbLoopMenu" Click="Loop_Click"/>
      <MenuFlyoutItem x:Name="LoopOffMenu" x:Uid="LoopOffMenu" Click="LoopOff_Click"/>
    </MenuFlyoutSubItem>
  </MenuFlyoutSubItem>
  <MenuFlyoutSubItem x:Name="VideoMenu" x:Uid="VideoMenu" AutomationProperties.AutomationId="VideoMenu">
    <MenuFlyoutItem x:Name="QuickSettingsMenu" x:Uid="VideoSettingsMenu" Tag="Video" Click="QuickSettingsMenu_Click"/>
    <MenuFlyoutItem x:Name="LayoutMenu" x:Uid="LayoutMenu" Click="LayoutMenu_Click"/>
    <MenuFlyoutSeparator/>
